{
  "ignition": {
    "version": "3.3.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "wheel",
          "docker"
        ],
        "homeDir": "/home/core",
        "name": "core",
        "passwordHash": "$y$j9T$KndhtpxqkHEV95qTo0X2l/$Tv5JQ.DcCVQFFXNuVcwvz8PYg77pemY0HwwHbN8FNC3",
        "sshAuthorizedKeys": [
          "ssh-rsa  tharaka@fedora"
        ],
        "shell": "/bin/bash"
      }
    ]
  },
  "storage": {
    "directories": [
      {
        "path": "/etc/ucore-autorebase",
        "mode": 492
      }
    ],
    "files": [
      {
        "path": "/var/home/core/install-user-tools.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=uCore autorebase to unsigned OCI and reboot\nConditionPathExists=!/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nStandardOutput=journal+console\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable\nExecStart=/usr/bin/touch /etc/ucore-autorebase/rebased\nExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-unsigned-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Enable podman.socket and podman-restart.service for core user\nAfter=default.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/loginctl enable-linger core\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reexec'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reload'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman.socket'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman.socket'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman-restart.service'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman-restart.service'\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "enable-user-podman-services.service"
      },
      {
        "contents": "[Unit]\nDescription=Install fzf, starship, and cockpit after ucore rebase\nAfter=multi-user.target network-online.target\nWants=network-online.target\nConditionPathExists=/etc/ucore-autorebase/rebased\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/runuser -l core -c '/var/home/core/install-user-tools.sh'\nExecStartPost=/usr/bin/rm -f /etc/ucore-autorebase/rebased\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "install-user-tools-after-rebase.service"
      }
    ]
  }
}
