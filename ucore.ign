  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=uCore autorebase to unsigned OCI and reboot\nConditionPathExists=!/etc/ucore-autorebase/unverified\nConditionPathExists=!/etc/ucore-autorebase/signed\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nStandardOutput=journal+console\nExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable\nExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified\nExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service\nExecStart=/usr/bin/systemctl reboot\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "ucore-unsigned-autorebase.service"
      },
      {
        "contents": "[Unit]\nDescription=Enable podman.socket and podman-restart.service for core user\nAfter=default.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/loginctl enable-linger core\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reexec'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reload'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman.socket'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman.socket'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman-restart.service'\nExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman-restart.service'\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "enable-user-podman-services.service"
      },
      {
        "contents": "[Unit]\nDescription=Install fzf and starship for core user\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/runuser -l core -c '/var/home/core/install-fzf.sh'\nExecStart=/usr/bin/runuser -l core -c '/var/home/core/install-starship.sh'\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "install-user-tools.service"
      },
      {
        "contents": "[Unit]\nDescription=Enable Cockpit after ucore rebase\nAfter=multi-user.target\nConditionPathExists=/usr/lib/systemd/system/cockpit.service\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/systemctl enable --now cockpit.service\nRemainAfterExit=true\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "enable-cockpit.service"
      }
    ]
  }
}
