variant: fcos
version: 1.4.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ssh-rsa  tharaka@fedora
      password_hash: $y$j9T$KndhtpxqkHEV95qTo0X2l/$Tv5JQ.DcCVQFFXNuVcwvz8PYg77pemY0HwwHbN8FNC3
      home_dir: /home/core
      groups:
        - wheel
        - docker
      shell: /bin/bash
storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
  files:
    - path: /var/home/core/install-fzf.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euxo pipefail
          git clone --depth 1 https://github.com/junegunn/fzf.git ~/.fzf
          ~/.fzf/install --all

    - path: /var/home/core/install-starship.sh
      mode: 0755
      contents:
        inline: |
          #!/bin/bash
          set -euxo pipefail
          curl -sS https://starship.rs/install.sh | sh -s -- --yes
          echo 'eval "$(starship init bash)"' >> ~/.bashrc
systemd:
  units:
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to unsigned OCI and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:ghcr.io/ublue-os/ucore-minimal:stable
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target

    - name: enable-user-podman-services.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable podman.socket and podman-restart.service for core user
        After=default.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/loginctl enable-linger core
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reexec'
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user daemon-reload'
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman.socket'
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman.socket'
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user enable podman-restart.service'
        ExecStart=/usr/bin/runuser -l core -c 'systemctl --user start podman-restart.service'
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    - name: install-user-tools.service
      enabled: true
      contents: |
        [Unit]
        Description=Install fzf and starship for core user
        After=network-online.target
        Wants=network-online.target

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/runuser -l core -c '/var/home/core/install-fzf.sh'
        ExecStart=/usr/bin/runuser -l core -c '/var/home/core/install-starship.sh'
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target

    - name: enable-cockpit.service
      enabled: true
      contents: |
        [Unit]
        Description=Enable Cockpit after ucore rebase
        After=multi-user.target
        ConditionPathExists=/usr/lib/systemd/system/cockpit.service

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/systemctl enable --now cockpit.service
        RemainAfterExit=true

        [Install]
        WantedBy=multi-user.target
